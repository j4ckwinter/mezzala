{
  "manifest_version": "0.4",
  "name": "mezzala",
  "display_name": "mezzala",
  "version": "0.3.1",
  "description": "Answers Football Manager 27 transfer, squad and tactics questions from your own save.",
  "author": {
    "name": "Jack Winter",
    "url": "https://github.com/j4ckwinter"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j4ckwinter/mezzala"
  },
  "homepage": "https://github.com/j4ckwinter/mezzala",
  "server": {
    "type": "uv",
    "entry_point": "src/mezzala/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "mezzala",
        "--fog-of-war",
        "${user_config.fog_of_war}"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "python": ">=3.12"
    }
  },
  "keywords": [
    "football manager",
    "fm27",
    "scouting"
  ],
  "license": "MIT",
  "user_config": {
    "fog_of_war": {
      "type": "boolean",
      "title": "Fog of war",
      "description": "Hide what Football Manager hides: ability and potential show as stars, and hidden attributes and personality numbers stay out of answers.",
      "default": false,
      "required": false
    }
  }
}
