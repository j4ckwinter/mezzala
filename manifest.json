{
  "manifest_version": "0.4",
  "name": "mezzala",
  "display_name": "mezzala",
  "version": "0.1.0",
  "description": "Answers Football Manager 27 transfer, squad and tactics questions from your own save.",
  "author": {
    "name": "Jack Winter",
    "url": "https://github.com/j4ckwinter"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j4ckwinter/mezzala"
  },
  "homepage": "https://github.com/j4ckwinter/mezzala",
  "server": {
    "type": "uv",
    "entry_point": "src/mezzala/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--directory", "${__dirname}", "mezzala"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32"],
    "runtimes": {
      "python": ">=3.12"
    }
  },
  "keywords": ["football manager", "fm27", "scouting"],
  "license": "MIT"
}
